rules_version = '2';
// Aphora Firestore rules. NOT deployed automatically — review, then:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isTherapist() {
      return signedIn() && exists(/databases/$(db)/documents/therapists/$(request.auth.uid));
    }
    function myCode() {
      return get(/databases/$(db)/documents/therapists/$(request.auth.uid)).data.code;
    }
    // Pack and level a therapist may set: null (follow the intake) or a
    // known pack / level 1-3.
    function validTherapistPlan(d) {
      return (!('therapistCondition' in d) || d.therapistCondition == null ||
              d.therapistCondition in ['child_speech_delay', 'adult_aphasia', 'oral_cancer_rehab']) &&
             (!('therapistLevel' in d) || d.therapistLevel == null ||
              (d.therapistLevel is int && d.therapistLevel >= 1 && d.therapistLevel <= 3));
    }
    // Private video room (see lib/logic/video_room.dart): a therapist may
    // create the pair's room on the patient doc only for their own code,
    // only in the `vernacura-` + 32 hex form, and never overwrite a room
    // that already belongs to them.
    function validVideoRoom(before, after) {
      return !after.diff(before).affectedKeys().hasAny(['videoRoom', 'videoRoomFor']) ||
        (after.get('videoRoomFor', '') == myCode() &&
         after.get('videoRoom', '') is string &&
         after.get('videoRoom', '').matches('vernacura-[0-9a-f]{32}') &&
         before.get('videoRoomFor', '') != myCode());
    }
    // The patient doc's linkedCaregiverId holds the therapist's share code.
    function linkedTo(patientUid) {
      return isTherapist() &&
        get(/databases/$(db)/documents/users/$(patientUid)).data.linkedCaregiverId == myCode();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid ||
                     (isTherapist() && resource.data.linkedCaregiverId == myCode()));
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      // A linked therapist may only change the note, the practice plan
      // (pack + level, which the app prefers over the intake result) and,
      // once, the pair's private video room.
      allow update: if linkedTo(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['therapistNote', 'therapistCondition', 'therapistLevel',
                    'videoRoom', 'videoRoomFor']) &&
        validTherapistPlan(request.resource.data) &&
        validVideoRoom(resource.data, request.resource.data);

      match /attempts/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || linkedTo(uid));
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /sessions/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || linkedTo(uid));
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /therapists/{tid} {
      // Patients look therapists up by code to link.
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == tid &&
        request.resource.data.keys().hasOnly(['name', 'phone', 'code']);
    }

    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid ||
                     (isTherapist() && resource.data.therapistId == myCode()));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      // Either side may change only the status.
      allow update: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         (isTherapist() && resource.data.therapistId == myCode())) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
